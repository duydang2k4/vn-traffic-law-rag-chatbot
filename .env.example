# Sao chép thành .env rồi điền key từ một dự án Gemini API Free.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Tùy chọn. Điền hạn mức của dự án trong https://aistudio.google.com/rate-limit
# để app chặn trước theo từng tiến trình. Để trống để dùng hạn mức Google.
GEMINI_RPM=
GEMINI_RPD=

# Chọn ollama để chạy cục bộ miễn phí hoặc extractive để chỉ trích nguồn.
# Chỉ cần hai biến sau khi LLM_PROVIDER=ollama-cloud. Cloud tính phí theo token.
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=gpt-oss:20b

# Chỉ cần khi LLM_PROVIDER=ollama. Điền tên model đã cài ở 127.0.0.1:11434.
OLLAMA_MODEL=

# Chỉ cần khi LLM_PROVIDER=groq để dùng Groq Free.
GROQ_API_KEY=
